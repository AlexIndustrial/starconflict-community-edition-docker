# Адрес этого сервера, который он сообщает игре.
# Игра ходит сюда за входом в ангар и за каждым боем, поэтому адрес должен
# быть доступен с того компьютера, где запущен клиент.
#
#   Игра на этом же компьютере -> оставь 127.0.0.1, в игре выбирай "localhost".
#   Игра на другом компьютере в домашней сети -> впиши локальный IP этого
#     сервера (узнать: Linux — `hostname -I`, macOS — `ipconfig getifaddr en0`),
#     в игре выбирай "server" и вводи этот IP с портом ниже.
#   Игра через интернет/VPN -> впиши белый IP или адрес в VPN-сети (например,
#     адрес Tailscale) и открой порты из README на фаерволе.
SERVER_HOST=127.0.0.1

# Порт входа. Менять обычно не нужно. Если сменил — тот же порт вводи в игре.
SERVER_PORT=3850

# Пароль встроенной консоли сервера (порт 2222, скрипт scripts/hub-console.sh).
# Команды консоли: help, status, enterMaintenanceMode, quit.
# Пароль нужен короткий и простой, из букв и цифр: движок 2015 года длинные
# и сложные значения может не принять.
SSH_PASSWD=hub1234

# Сторожок нулевого вызова в DedicatedServer.exe. Обязателен (1), если
# SERVER_HOST отличен от 127.0.0.1, иначе дедики падают на старте боя.
PATCH_SECURITY=0

# Куда вешать SERVER_HOST внутри netns контейнера (Hub ищет свою ноду
# среди локальных адресов; хост и VPN не трогаются):
#   dummy — отдельный dummy-интерфейс (Mac, тесты);
#   eth0  — вторичный /32 на интерфейсе default-маршрута (Linux-прод;
#           dummy с флагом NOARP Hub под Linux не видит);
#   none  — не трогать (белый IP уже висит на самой машине, вариант A).
FAKE_IF_MODE=dummy

# 1 — прописывать SERVER_HOST первым за hostname в /etc/hosts контейнера
# (от резолва зависит -hub у дедиков). Docker иногда стирает строку при
# рестарте — тогда просто перезапусти контейнер.
FAKE_HOSTS=1
